# Porta HTTP da API
PORT=3333

# Segredo para assinar os tokens JWT. Obrigatório em produção (mínimo de 32 caracteres).
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Validade do token de acesso, em horas
TOKEN_VALIDADE_HORAS=8

# Origens liberadas no CORS, separadas por vírgula (frontend Vite)
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Popula os repositórios em memória com dados de demonstração (padrão: true fora de produção)
SEED_DEMO=true
